# Silyn local environment — example
#
# Usage:
#   cp .env.example .env
#   # then fill in DEEPSEEK_API_KEY
#
# .env is git-ignored. Never commit real keys.
# CI uses the repository secret DEEPSEEK_API_KEY; the committed .env.example stays empty.
# Silyn loads .env only in local development. Production/eval workflows read real env vars.

# --- LLM gateway (OpenAI-compatible) ---

# Provider id. Only "openai-compatible" is implemented in the MVP.
SILYN_LLM_PROVIDER=openai-compatible

# DeepSeek official OpenAI-compatible endpoint.
SILYN_LLM_BASE_URL=https://api.deepseek.com/v1

# Model id pinned for a run or experiment.
# Record the actual model id returned by the provider in the experiment report.
# Candidate ids: deepseek-chat, deepseek-reasoner (verify tool-calling support before use).
SILYN_LLM_MODEL=deepseek-chat

# Name of the environment variable that holds the API key.
# The gateway reads the key indirectly so provider keys never live in config files.
SILYN_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

# Server-side only. Leave empty in this file; set it in .env.
DEEPSEEK_API_KEY=

# Request behavior.
SILYN_LLM_TIMEOUT_SECS=120
SILYN_LLM_MAX_RETRIES=3

# --- Local data ---

# SQLite database, blobs, checkpoints and run artifacts.
SILYN_HOME=.silyn

# trace | debug | info | warn | error
SILYN_LOG_LEVEL=info

# --- Run budgets (MVP defaults) ---

SILYN_MAX_STEPS=40
SILYN_MAX_TOKENS=200000
SILYN_MAX_COST_USD=1.0
SILYN_MAX_WALL_SECS=600

# --- Evaluation ---

# mock | deepseek
# Keep "mock" for local development and pull-request CI.
# Real-model experiments must be triggered explicitly and are cost-capped.
SILYN_EVAL_PROVIDER=mock
SILYN_EVAL_REPEATS=3
SILYN_EVAL_MAX_CANDIDATES=3
SILYN_EVAL_MAX_COST_USD=5.0
