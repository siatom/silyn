{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silyn.dev/schemas/suite_manifest.schema.json",
  "title": "SuiteManifest",
  "type": "object",
  "required": [
    "suite_id",
    "version",
    "task_family",
    "repeats",
    "splits",
    "thresholds",
    "sealed"
  ],
  "additionalProperties": false,
  "properties": {
    "suite_id": { "type": "string" },
    "version": { "type": "string" },
    "task_family": { "type": "string" },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 5 },
    "splits": {
      "type": "object",
      "required": ["train", "dev", "test"],
      "additionalProperties": false,
      "properties": {
        "train": { "$ref": "#/$defs/split" },
        "dev": { "$ref": "#/$defs/split" },
        "test": { "$ref": "#/$defs/split" }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["min_gain_pp", "max_cost_ratio", "max_regression_pp", "max_cost_usd"],
      "additionalProperties": false,
      "properties": {
        "min_gain_pp": { "type": "number" },
        "max_cost_ratio": { "type": "number" },
        "max_regression_pp": { "type": "number" },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "sealed": { "type": "boolean" }
  },
  "$defs": {
    "split": {
      "type": "object",
      "required": ["count", "sha256"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
