{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silyn.dev/schemas/eval_report.schema.json",
  "title": "EvaluationReport",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "suite_version",
    "model_id",
    "baseline_id",
    "repeats",
    "arms",
    "thresholds",
    "verdict",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "candidate_id": { "type": "string", "format": "uuid" },
    "suite_version": { "type": "string" },
    "model_id": { "type": "string" },
    "model_reported": { "type": "string" },
    "baseline_id": { "type": "string" },
    "repeats": { "type": "integer", "minimum": 1 },
    "arms": {
      "type": "object",
      "required": ["A", "B", "C"],
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/$defs/arm" },
        "B": { "$ref": "#/$defs/arm" },
        "C": { "$ref": "#/$defs/arm" }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["min_gain_pp", "max_cost_ratio", "max_regression_pp"],
      "additionalProperties": false,
      "properties": {
        "min_gain_pp": { "type": "number" },
        "max_cost_ratio": { "type": "number" },
        "max_regression_pp": { "type": "number" }
      }
    },
    "verdict": { "type": "string", "enum": ["promote", "reject", "await_approval", "invalid"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "arm": {
      "type": "object",
      "required": ["successes", "total", "cost_usd"],
      "additionalProperties": false,
      "properties": {
        "successes": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "latency_p50_ms": { "type": "number", "minimum": 0 },
        "latency_p95_ms": { "type": "number", "minimum": 0 },
        "tool_errors": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
