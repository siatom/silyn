{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silyn.dev/schemas/policy_artifact.schema.json",
  "title": "PolicyArtifact",
  "type": "object",
  "required": ["schema_version", "context", "planner", "tools", "verification"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "context": {
      "type": "object",
      "required": ["memory_budget_ratio", "retrieval"],
      "additionalProperties": false,
      "properties": {
        "memory_budget_ratio": { "type": "number", "minimum": 0.0, "maximum": 0.6 },
        "retrieval": {
          "type": "object",
          "required": ["bm25_k", "max_evidence"],
          "additionalProperties": false,
          "properties": {
            "bm25_k": { "type": "integer", "minimum": 1, "maximum": 200 },
            "max_evidence": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        }
      }
    },
    "planner": {
      "type": "object",
      "required": ["prompt_fragments", "rules"],
      "additionalProperties": false,
      "properties": {
        "prompt_fragments": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": { "type": "object" }
      }
    },
    "tools": {
      "type": "object",
      "required": ["allowlist"],
      "additionalProperties": false,
      "properties": {
        "allowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "required": ["checkers"],
      "additionalProperties": false,
      "properties": {
        "checkers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
